<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Tests for bugs the site still has. They are EXPECTED TO FAIL until the bug is fixed,
     so the regression/smoke suites (and CI) skip them.
     Run: mvn test -DsuiteXml=src/test/resources/known-defects.xml
     When one starts passing, the bug is fixed: move the test into the "regression" group. -->
<suite name="Known defects" parallel="methods" thread-count="4">
    <test name="Known defect tests">
        <groups>
            <run>
                <include name="known-defect"/>
            </run>
        </groups>
        <packages>
            <package name="com.nevena.ecommerce.tests"/>
        </packages>
    </test>
</suite>
