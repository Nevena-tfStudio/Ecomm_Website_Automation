<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression suite: the default for "mvn test" -->
<!-- parallel="methods": test methods run at the same time, each with its own browser -->
<suite name="Regression" parallel="methods" thread-count="4">
    <test name="Regression tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.nevena.ecommerce.tests"/>
        </packages>
    </test>
</suite>
