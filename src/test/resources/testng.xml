<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression suite: the default for "mvn test" -->
<suite name="Regression">
    <test name="Regression tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.nevena.ecommerce.tests"/>
        </packages>
    </test>
</suite>
